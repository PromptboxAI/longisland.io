# Copy to .env.local and fill in. Never commit real values.
# See docs/setup.md for where each value comes from.

# --- Supabase (current key system) --------------------------------------------
# Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe. RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET — bypasses RLS. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Yelp Fusion --------------------------------------------------------------
# Server-only.
YELP_API_KEY=your-yelp-api-key

# --- Site ---------------------------------------------------------------------
# Canonical origin for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
